# ==============================================================================
# Toko Briyani — Environment Configuration
# Copy this file to .env.local and fill in your real project values.
# NEVER commit .env.local or real secret keys to version control.
# ==============================================================================

# Supabase Project URL (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (safe for browser use, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SERVER-ONLY — NEVER prefix with NEXT_PUBLIC_)
# Used exclusively on the server for verified order creation and admin storage uploads.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Fallback Store WhatsApp Number in international format without "+" or spaces
# Example: 6281234567890 (can also be overridden in Admin -> Store Settings)
NEXT_PUBLIC_STORE_WHATSAPP=6280000000000

# Optional public site URL for Open Graph metadata and canonical links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
